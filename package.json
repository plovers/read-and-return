{
  "name": "read-and-return",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Lightweight jump-and-return navigation for long Obsidian notes",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "fixture": "tsx scripts/long-note.ts",
    "release": "npm run build && npm test && node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
